# References and nonsecret values only. Never put credentials in this file.
APPLE_API_KEY_REF=file://$HOME/.config/flutter_starter/AuthKey_KEYID.p8
APNS_KEY_REF=file://$HOME/.config/flutter_starter/AuthKey_APNS.p8
IOS_DISTRIBUTION_CERTIFICATE_REF=file://$HOME/.config/flutter_starter/distribution.p12
IOS_DISTRIBUTION_CERTIFICATE_PASSWORD_REF=keychain://flutter_starter/ios-certificate
IOS_PROVISIONING_PROFILE_REF=file://$HOME/.config/flutter_starter/profile.mobileprovision
ANDROID_UPLOAD_KEYSTORE_REF=file://$HOME/.config/flutter_starter/upload.jks
ANDROID_KEYSTORE_PASSWORD_REF=keychain://flutter_starter/android-keystore
ANDROID_KEY_PASSWORD_REF=keychain://flutter_starter/android-key
FIREBASE_ANDROID_CONFIG_REF=file://$HOME/.config/flutter_starter/google-services.json
FIREBASE_IOS_CONFIG_REF=file://$HOME/.config/flutter_starter/GoogleService-Info.plist
PRIVATE_STORE_METADATA_REF=file://$HOME/.config/flutter_starter/private-store-metadata.json
TESTER_LISTS_REF=file://$HOME/.config/flutter_starter/testers.json
