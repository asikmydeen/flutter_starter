# Tooling
.dart_tool/
.flutter-plugins-dependencies
.fvm/
build/
.idea/
.vscode/
*.iml
.DS_Store
.claude/scratch/
.release-readiness/

# Platform
ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties
ios/Flutter/ephemeral/

# Secrets — never commit env files or keys
.env
.env.*
!.env.release.local.example
*.keystore
*.jks
key.properties
AuthKey_*.p8
*.p12
*.mobileprovision
*.pem
*.key
**/*service-account*.json
**/*service_account*.json
**/private-store-metadata*.json
android/app/**/google-services.json
ios/Runner/GoogleService-Info.plist

# Test artifacts
coverage/
test/**/failures/

# NOTE (agents): generated files (*.g.dart, *.freezed.dart) ARE committed.
# CI fails if they drift from source — always run codegen after editing
# annotated files. pubspec.lock is also committed for reproducible builds.
