{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutterstarter.dev/schemas/starter.schema.json",
  "title": "Flutter starter project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "platforms", "environments", "branding", "readiness"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "displayName", "legalName", "organization", "defaultLocale", "supportedLocales"],
      "properties": {
        "packageName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "displayName": {"type": "string", "minLength": 1},
        "legalName": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
        "defaultLocale": {"type": "string", "minLength": 2},
        "supportedLocales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["android", "ios"],
      "properties": {
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationId", "minSdk", "targetSdk"],
          "properties": {
            "applicationId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"},
            "minSdk": {"type": "integer", "minimum": 24},
            "targetSdk": {"type": "integer", "minimum": 36}
          }
        },
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundleId", "minimumVersion"],
          "properties": {
            "bundleId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9-]*)+$"},
            "minimumVersion": {"type": "string", "pattern": "^([1-9][0-9]*)\\.([0-9]+)$"}
          }
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "staging", "prod"],
      "properties": {
        "dev": {"$ref": "#/$defs/environment"},
        "staging": {"$ref": "#/$defs/environment"},
        "prod": {"$ref": "#/$defs/environment"}
      }
    },
    "branding": {"type": "object"},
    "readiness": {"type": "object"}
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiBaseUrl", "firebaseProjectId"],
      "properties": {
        "apiBaseUrl": {"type": "string"},
        "firebaseProjectId": {"type": "string"}
      }
    }
  }
}
